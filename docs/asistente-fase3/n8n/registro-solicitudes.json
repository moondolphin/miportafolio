            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "operation-consult",
              "leftValue": "={{ $json.operacion }}",
              "rightValue": "consultar",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "consulta-pg",
      "name": "Consultar en PostgreSQL",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        900,
        -300
      ],
      "onError": "continueErrorOutput",
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT los_tilos.consultar_solicitud_turno($1::uuid, $2::text, $3::text) AS respuesta;",
        "options": {
          "queryReplacement": "={{ [ $json.payload.clave_idempotencia, $json.payload.correo, $json.payload.comprobante_hash ] }}"
        }
      }
    },
    {
      "id": "consulta-response",
      "name": "Responder consulta",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.4,
      "position": [
        1120,
        -300
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ $json.respuesta }}",
        "options": {
          "responseCode": "={{ $json.respuesta.resultado === 'encontrada' ? 200 : 404 }}"
        }
      }
    }
  ],
