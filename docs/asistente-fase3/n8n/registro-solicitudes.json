{
  "name": "Los Tilos - registrar y consultar solicitudes",
  "nodes": [
    {
      "id": "registro-webhook",
      "name": "Registro POST",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "los-tilos/solicitudes-turno",
        "authentication": "headerAuth",
